{
  "name": "inbox_graph",
  "version": "1.0.0",
  "description": "Gmail to ArangoDB graph indexer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build --ssr src/index.ts",
    "start": "NODE_ENV=production node dist/index.js",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "lint:fix": "biome check --fix src/"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@google-cloud/tasks": "^6.2.3",
    "@hono/node-server": "^2.0.5",
    "@lucide/vue": "^1.18.0",
    "arangojs": "^10.3.1",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.7.0",
    "googleapis": "^173.0.0",
    "hono": "^4.12.25",
    "p-limit": "^7.3.0",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@hono/vite-dev-server": "^0.26.0",
    "@types/node": "24.x",
    "@vitejs/plugin-vue": "^6.0.7",
    "sass": "^1.101.0",
    "tsx": "4.22.x",
    "typescript": "6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
