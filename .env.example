# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ArangoDB Connection
ARANGO_URL=http://localhost:8529
ARANGO_DATABASE=inbox_graph
ARANGO_USERNAME=root
ARANGO_PASSWORD=

# Google Cloud Tasks (optional for local dev)
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_TASKS_QUEUE=sync-queue
# GOOGLE_CLOUD_TASKS_LOCATION=us-central1
# GOOGLE_CLOUD_TASKS_HANDLER_URL=http://localhost:4000
# GOOGLE_CLOUD_TASKS_TOPIC=gmail-notifications

# Server
PORT=4000
